{
  "name": "hostel-daily-report-app",
  "version": "1.0.0",
  "description": "Daily Hostel Report Web Application connected to PostgreSQL Backend",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently --kill-others \"node server/index.js\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client run build",
    "install-all": "npm install && npm --prefix client install",
    "postinstall": "npm --prefix client install"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
